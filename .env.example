# =============================================================================
# Azure OpenAI — v1 unified endpoint (no API version string required)
# =============================================================================
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-terra

# =============================================================================
# Azure AI Content Safety / Prompt Shield — used by Demo 1 & Demo 3
# =============================================================================
AZURE_CONTENT_SAFETY_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_CONTENT_SAFETY_KEY=your_content_safety_key_here

# =============================================================================
# Security toggle — Demos 01/02/04: false|true only; Demo 03: false|policy|all (true aliases to all).
# Demo 04 is strict: any value other than false or true fails loudly at startup.
# =============================================================================
SECURITY_ENABLED=false
